        $alwaysHideFields = ['id', 'created_at', 'updated_at'];

        // Module-wise fields to hide
        $moduleHideFields = [
            'teammember' => ['mentor_id', 'title_id', 'employment_status', 'department', 'originalnda', 'teamlead', 'nda', 'rejoining_date', 'reasonofleaving', 'dateofresign', 'created_by', 'linkedin', 'about', 'verify', 'relievingstatus', 'category', 'cost_hour', 'salary_range', 'monthly_gross_salary', 'pf_applicable', 'timesheet_applicable', 'taxtds', 'taxgrosssalary', 'taxpf', 'rejoiningsamepost', 'change_type', 'staffcodenumber', 'appointment_letter', 'addressupload', 'panupload', 'cancelcheque', 'aadharupload', 'document_file'],
