    public function teammemberDocument($id, $document, $action)
    {
        $documents = [
            'profilepic' => ['path' => 'backEnd/image/teammember/profilepic', 'original' => null, 'label' => 'Profile Pic'],
            'addressupload' => ['path' => 'backEnd/image/teammember/addressupload', 'original' => 'originaladdressupload', 'label' => 'Address Proof'],
            'aadharupload' => ['path' => 'backEnd/image/teammember/aadharupload', 'original' => 'originalaadharupload', 'label' => 'Aadhaar Card'],
            'panupload' => ['path' => 'backEnd/image/teammember/panupload', 'original' => 'originalpanupload', 'label' => 'PAN Card'],
            'appointment_letter' => ['path' => 'backEnd/image/teammember/appointmentletter', 'original' => 'originalappointment_letter', 'label' => 'Appointment Letter'],
            'nda' => ['path' => 'backEnd/image/teammember/nda', 'original' => 'originalnda', 'label' => 'NDA'],
            'cancelcheque' => ['path' => 'backEnd/image/teammember/cancelcheque', 'original' => 'originalcancelcheque', 'label' => 'Bank Proof'],
        ];

        if (!isset($documents[$document]) || !in_array($action, ['view', 'download'])) {
            abort(422);
        }

        $teammember = Teammember::findOrFail($id);
        $fileName = $teammember->getRawOriginal($document);
        $filePath = $this->getTeammemberDocumentPath($documents[$document]['path'], $fileName);

        if (!$filePath) {
            abort(422);
        }

        $originalFileName = $documents[$document]['original'] ? $teammember->getRawOriginal($documents[$document]['original']) : null;

        $documentLogData = [
            'document_type' => $documents[$document]['label'],
            'document_file' => $originalFileName ?: $fileName,
        ];

        if ($action === 'view') {
            $documentLogData = [
                'teamember_name' => $teammember->team_member,
                'document_type' => $documents[$document]['label'],
                'document_file' => $fileName,
                'original_file' => $originalFileName ?: $fileName,
            ];
        }

        $this->logTeammemberDocumentAction($action, $id, $id, $documentLogData);

        if ($action === 'download') {
            return response()->download($filePath, $originalFileName ?: $fileName);
        }

        return response()->file($filePath, [
            'Cache-Control' => 'no-store, no-cache, must-revalidate, max-age=0',
            'Pragma' => 'no-cache',
            'Expires' => '0',
        ]);
    }
	
	
	
	
	
	
	
	

