    public static function activityLogsDetails($module, $action, $recordId = null, $userid = null, $oldData = null, $newData = null)
    {


        $changes = [];

        if ($action === 'create') {
            $moduleName = ucwords(str_replace('_', ' ', $module));
            $changes['message_details'] = [
                'old' => null,
                'new' => $moduleName . ' has been created'
            ];
        } elseif ($module === 'teammember' && $action === 'viewed') {
            $changes['message_details'] = [
                'old' => null,
                'new' => 'Viewed details has been created'
            ];
        } else {
            if (is_array($oldData) && is_array($newData)) {
                foreach ($newData as $key => $value) {

                    $oldValue = $oldData[$key] ?? null;

                    if ($oldValue != $value) {
                        $changes[$key] = [
                            'old' => $oldValue,
                            'new' => $value
                        ];
                    }
                }
            }
        }

        // dd($oldData, $newData, $changes);

        $actionName = class_basename(request()->route()->getActionName());
        $pagename = substr($actionName, 0, strpos($actionName, "Controller"));

        DB::table('activitylogs_details')->insert([
            'module' => $module,
            'action' => $action,
            'record_id' => $recordId,
            'activitytitle' => $pagename,
            'performed_by' => auth()->user()->teammember_id ?? null,
            'old_data' => $oldData ? json_encode($oldData) : null,
            'new_data' => $newData ? json_encode($newData) : null,
            'changed_fields' => !empty($changes) ? json_encode($changes) : null,
            'ip_address' => request()->ip(),
            'teammember_id' => $userid,
            'created_at' => now(),
            'updated_at' => now(),
        ]);
    }
	








