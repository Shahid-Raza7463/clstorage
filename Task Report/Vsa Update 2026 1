  public function checkAssignmentStatus(Request $request)
  {
    if ($request->ajax() && isset($request->id)) {
      try {
        $checkindependence = DB::table('assignmentmappings')->where('assignmentgenerate_id', $request->id)->first();

        // Check independence confirmations
        $independenceconfirmation = DB::table('assignmentmappings')
          ->Join('assignmentteammappings', 'assignmentteammappings.assignmentmapping_id', '=', 'assignmentmappings.id')
          ->Join('teammembers', 'teammembers.id', '=', 'assignmentteammappings.teammember_id')
          ->Join('roles', 'roles.id', '=', 'teammembers.role_id')
          ->where('assignmentmappings.assignmentgenerate_id', $request->id)
          ->where('assignmentteammappings.viewerteam', null)
          ->select('teammembers.id', 'teammembers.staffcode', 'roles.rolename', 'teammembers.team_member', 'assignmentmappings.assignmentgenerate_id')
          ->union(
            DB::table('assignmentmappings')
              ->join('teammembers', 'teammembers.id', '=', 'assignmentmappings.leadpartner')
              ->join('roles', 'roles.id', '=', 'teammembers.role_id')
              ->where('assignmentmappings.assignmentgenerate_id', $request->id)
              ->select('teammembers.id', 'teammembers.staffcode', 'roles.rolename', 'teammembers.team_member', 'assignmentmappings.assignmentgenerate_id')
          )
          ->union(
            DB::table('assignmentmappings')
              ->join('teammembers', 'teammembers.id', '=', 'assignmentmappings.otherpartner')
              ->join('roles', 'roles.id', '=', 'teammembers.role_id')
              ->where('assignmentmappings.assignmentgenerate_id', $request->id)
              ->select('teammembers.id', 'teammembers.staffcode', 'roles.rolename', 'teammembers.team_member', 'assignmentmappings.assignmentgenerate_id')
          )
          ->count();

        $independencesubmit = DB::table('independences')
          ->where('assignmentgenerate_id', $request->id)
          ->count();


        if ($checkindependence->independenceform == 2) {
          if ($independencesubmit != $independenceconfirmation) {
            return response()->json([
              'canProceed' => false,
              'reason' => 'independence'
            ]);
          }
        }
        // Check balance confirmation status
        $assignment = DB::table('assignmentbudgetings')
          ->where('assignmentgenerate_id', $request->id)
          ->first();

        if ($assignment && $assignment->balanceconfirmationstatus == 1) {
          return response()->json([
            'canProceed' => false,
            'reason' => 'balance'
          ]);
        }

        return response()->json([
          'canProceed' => true
        ]);
      } catch (Exception $e) {
        return response()->json([
          'canProceed' => false,
          'reason' => 'error'
        ], 500);
      }
    }
  }







